---
import Stores from './Stores.astro';
import PhoneOrder from './fragments/PhoneOrder.astro';
import LunchOrder from './fragments/LunchOrder.astro';
import type { T } from '../i18n/content';
interface Props { t: T; mode: 'kids' | 'business'; h2: string; lines: string[]; field: 'yellow' | 'mint' }
const { t, mode, h2, lines, field } = Astro.props;
---
<section class={`cta field-${field}`} aria-labelledby="cta-title">
  <div class="inner">
    <div class="words">
      <h2 id="cta-title" data-reveal data-fit data-fit-min="28">{h2}</h2>
      <div class="lines" data-reveal style="--i:1">
        {lines.map((l) => <p>{l}</p>)}
      </div>
      <div data-reveal style="--i:2"><Stores /></div>
    </div>
    <div class="pic" data-reveal style="--i:1">
      <div data-drift>{mode === 'kids' ? <PhoneOrder t={t} /> : <LunchOrder t={t} phone />}</div>
    </div>
  </div>
</section>

<script>
  // One moving picture: the product drifts slowly against the scroll.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const imgs = [...document.querySelectorAll<HTMLElement>('[data-drift]')];
  if (!reduce && imgs.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      for (const img of imgs) {
        const r = img.parentElement!.getBoundingClientRect();
        const p = (window.innerHeight - r.top) / (window.innerHeight + r.height);
        if (p < -0.1 || p > 1.1) continue;
        img.style.transform = `translate3d(0, ${(0.5 - p) * 80}px, 0) rotate(${(0.5 - p) * 4}deg)`;
      }
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .cta { margin-top: var(--section); padding: 0 var(--gutter); }
  .inner {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    min-height: min(84svh, 820px); border-radius: var(--radius); overflow: hidden;
    position: relative;
  }
  .spot { position: absolute; z-index: 1; }
  .spot img { width: 100%; }
  .field-yellow .inner { background: var(--yellow); }
  .field-mint .inner { background: var(--mint); }
  .words {
    grid-column: 1 / 8; align-self: end; display: grid; gap: 28px;
    padding: 40px clamp(24px, 3.5vw, 56px) clamp(40px, 4vw, 64px);
  }
  h2 { font-size: var(--s-display); line-height: 0.92; letter-spacing: -0.03em; }
  .lines { display: grid; gap: 4px; max-width: 46ch; font-weight: 600; font-size: var(--s-body); }
  .pic { grid-column: 8 / 13; position: relative; display: grid; place-items: end center; padding-top: 48px; }
  .pic [data-drift] { will-change: transform; margin-bottom: -40px; transform-origin: 50% 100%; }

  @media (max-width: 860px) {
    .inner { grid-template-columns: 1fr; min-height: 84svh; }
    .words { grid-column: 1; grid-row: 1; align-self: start; padding: 40px 20px 24px; }
    .pic { grid-column: 1; grid-row: 2; padding-top: 0; }
    .pic [data-drift] { will-change: transform; margin-bottom: -40px; transform-origin: 50% 100%; }
    .spot { display: none; }
  }
</style>
