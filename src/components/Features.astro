---
import type { T } from '../i18n/content';
interface Props { t: T }
const { t } = Astro.props;
const f = t.kids.features;
const ui = t.ui;
// Today is Tuesday before the 08:00 cutoff. Monday is past, Tuesday ordered.
const initial = ['ordered', 'ordered', 'none', 'none', 'none'];
const parts = ui.lunchDish.split(', ');
const order = ['ease', 'transparency', 'control', 'auto', 'personal'] as const;
---
<section class="features" id="features" aria-labelledby="features-title">
  <h2 id="features-title" data-reveal data-fit>{f.h2[0]} <span class="h2-second"><span class="pop">{f.h2[1]}</span></span></h2>
  <div class="f-stage">
    <div class="field">
      <div class="app ds-screen" data-ui data-app aria-live="polite">
        <div class="ds-top">
          <span class="ds-child"><span class="ds-avatar" aria-hidden="true">E</span><span><b>{ui.childName}</b><small>{ui.childGroup}</small></span><svg class="ds-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></span>
          <span class="ds-date"><svg class="ds-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>{ui.range}</span>
        </div>
        <p class="ds-callout"><svg class="ds-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>{ui.cutoff}</p>
        <p class="app-profile">
          <span class="ds-chip">{ui.portion}: <b data-portion>{ui.portions[1]}</b></span>
          <span data-allergy-tags></span>
        </p>
        <ol class="days ds-card" role="list">
          {ui.days.map((d, i) => (
            <li class="day ds-row" data-day={i} data-state={initial[i]}>
              <img class="ds-meal" src="/images/ds/taco.svg" alt="" width="32" height="32" />
              <div class="meal">
                <span class="ds-row-title">{d} · {ui.dates[i]} <span class="auto-badge ds-pill ds-pill-positive" hidden>{ui.auto}</span></span>
                <span class="ds-row-sub dish">{ui.lunch} · {ui.lunchDish}</span>
                {i === 0 && (
                  <span class="log" data-log hidden>
                    <span class="ok"><svg class="ds-ico" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only">{ui.eaten}:</span> {parts[0]}</span>
                    <span class="ok"><svg class="ds-ico" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only">{ui.eaten}:</span> {parts[1]}</span>
                    {parts[2] && <span class="no"><svg class="ds-ico" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg><span class="sr-only">{ui.notEaten}:</span> {parts[2]}</span>}
                  </span>
                )}
              </div>
              <div class="ds-row-end">
                <span class="status ds-pill" data-status>{initial[i] === 'ordered' ? ui.ordered : ui.notOrdered}</span>
                <span class="ds-price">{ui.perDay}</span>
              </div>
            </li>
          ))}
        </ol>
        <div class="ds-cart">
          <div><b data-total>10,00 €</b><small data-changes>0 {ui.changeForms[2]}</small></div>
          <span class="ds-btn">{ui.reviewOrder}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="f-read">
    <div class="block" data-reveal>
      <div class="title"><img class="sticker" src="/images/ill/ease.webp" alt="" width="560" height="560" loading="lazy" /><h3>{f.items.ease[0]}</h3></div>
      <p>{f.items.ease[1]}</p>
      <button type="button" class="ctl ctl-primary" data-act="order">
        <span>{ui.order}</span><span class="ctl-day" data-next-day>· {ui.days[2]}</span>
      </button>
    </div>

    <div class="block" data-reveal>
      <div class="title"><img class="sticker" src="/images/ill/transparency.webp" alt="" width="560" height="560" loading="lazy" /><h3>{f.items.transparency[0]}</h3></div>
      <p>{f.items.transparency[1]}</p>
      <button type="button" class="switch" role="switch" aria-checked="false" data-act="log">
        <span class="knob" aria-hidden="true"></span><span>{ui.logToggle}</span>
      </button>
    </div>

    <div class="block" data-reveal>
      <div class="title"><img class="sticker" src="/images/ill/control.webp" alt="" width="560" height="560" loading="lazy" /><h3>{f.items.control[0]}</h3></div>
      <p>{f.items.control[1]}</p>
      <fieldset class="seg" data-act="tue">
        <legend>{ui.days[1]} · {ui.cutoff}</legend>
        <label><input type="radio" name="tue" value="ordered" checked /><span>{ui.ordered}</span></label>
        <label><input type="radio" name="tue" value="cancelled" /><span>{ui.cancel}</span></label>
      </fieldset>
    </div>

    <div class="block" data-reveal>
      <div class="title"><img class="sticker" src="/images/ill/auto.webp" alt="" width="560" height="560" loading="lazy" /><h3>{f.items.auto[0]}</h3></div>
      <p>{f.items.auto[1]}</p>
      <button type="button" class="switch" role="switch" aria-checked="false" data-act="auto">
        <span class="knob" aria-hidden="true"></span><span>{ui.autoToggle}</span>
      </button>
    </div>

    <div class="block" data-reveal>
      <div class="title"><img class="sticker" src="/images/ill/personal.webp" alt="" width="560" height="560" loading="lazy" /><h3>{f.items.personal[0]}</h3></div>
      <p>{f.items.personal[1]}</p>
      <fieldset class="seg" data-act="portion">
        <legend>{ui.portion}</legend>
        {ui.portions.map((p, i) => (
          <label><input type="radio" name="portion" value={p} checked={i === 1} /><span>{p}</span></label>
        ))}
      </fieldset>
      <fieldset class="chips" data-act="allergy">
        <legend>{ui.allergies}</legend>
        {ui.allergens.map((a) => (
          <label><input type="checkbox" value={a} /><span>{a}</span></label>
        ))}
      </fieldset>
    </div>
  </div>
</section>

<script define:vars={{ labels: { ordered: ui.ordered, none: ui.notOrdered, cancelled: ui.cancelled, days: ui.days, forms: ui.changeForms, lang: t.lang } }}>
  const root = document.querySelector('[data-app]');
  const section = root && root.closest('section');
  if (root && section) {
    const rows = [...root.querySelectorAll('.day')];
    const state = rows.map((r) => r.dataset.state);
    let auto = false;
    const fmt = (n) => n.toFixed(2).replace('.', ',') + ' €';
    const flash = (el) => { el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash'); };
    const nextBtn = section.querySelector('[data-act="order"]');
    const nextDay = section.querySelector('[data-next-day]');
    let changes = 0;
    const plural = (n) => {
      const [one, few, many] = labels.forms;
      if (labels.lang === 'en') return n === 1 ? one : few;
      if (labels.lang === 'lt') return n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && (n % 100 < 10 || n % 100 >= 20) ? few : many;
      return n === 1 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? few : many;
    };
    const bump = () => { changes++; const c = root.querySelector('[data-changes]'); c.textContent = changes + ' ' + plural(changes); flash(root.querySelector('.ds-cart')); };

    function render(changed) {
      rows.forEach((row, i) => {
        row.dataset.state = state[i];
        const pill = row.querySelector('[data-status]');
        pill.textContent = labels[state[i]];
        pill.className = 'status ds-pill' + (state[i] === 'ordered' ? ' ds-pill-positive' : state[i] === 'cancelled' ? ' ds-pill-negative' : '');
        row.querySelector('.auto-badge').hidden = !(auto && i > 1 && state[i] === 'ordered');
      });
      const total = state.filter((s) => s === 'ordered').length * 5;
      root.querySelector('[data-total]').textContent = fmt(total);
      const next = state.findIndex((s, i) => i > 1 && s === 'none');
      nextBtn.disabled = next === -1;
      nextDay.textContent = next === -1 ? '' : '· ' + labels.days[next];
      if (changed != null) flash(rows[changed]);
    }

    nextBtn.addEventListener('click', () => {
      const i = state.findIndex((s, j) => j > 1 && s === 'none');
      if (i === -1) return;
      state[i] = 'ordered';
      render(i);
      bump();
    });

    section.querySelector('[data-act="log"]').addEventListener('click', (e) => {
      const btn = e.currentTarget;
      const on = btn.getAttribute('aria-checked') !== 'true';
      btn.setAttribute('aria-checked', String(on));
      root.querySelector('[data-log]').hidden = !on;
      flash(rows[0]);
    });

    section.querySelectorAll('input[name="tue"]').forEach((input) =>
      input.addEventListener('change', () => { state[1] = input.value; render(1); bump(); }),
    );

    section.querySelector('[data-act="auto"]').addEventListener('click', (e) => {
      const btn = e.currentTarget;
      auto = btn.getAttribute('aria-checked') !== 'true';
      btn.setAttribute('aria-checked', String(auto));
      for (let i = 2; i < state.length; i++) if (auto && state[i] === 'none') state[i] = 'ordered';
      render();
      rows.slice(2).forEach(flash);
      bump();
    });

    section.querySelectorAll('input[name="portion"]').forEach((input) =>
      input.addEventListener('change', () => {
        root.querySelector('[data-portion]').textContent = input.value;
        flash(root.querySelector('.app-profile'));
        bump();
      }),
    );

    const tags = root.querySelector('[data-allergy-tags]');
    section.querySelectorAll('[data-act="allergy"] input').forEach((input) =>
      input.addEventListener('change', () => {
        const on = [...section.querySelectorAll('[data-act="allergy"] input:checked')].map((x) => x.value);
        tags.innerHTML = '';
        on.forEach((a) => {
          const s = document.createElement('span');
          s.className = 'ds-chip ds-chip-alert';
          s.textContent = a;
          tags.append(s);
        });
        flash(root.querySelector('.app-profile'));
        bump();
      }),
    );

    render();
  }
</script>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-inline: var(--gutter);
    padding-top: var(--section);
  }
  .f-stage { grid-column: 1 / 7; grid-row: 1 / span 2; }
  .field {
    position: sticky; top: var(--gutter);
    height: calc(100svh - 2 * var(--gutter));
    min-height: 640px;
    background: var(--mint);
    border-radius: var(--radius);
    display: grid; place-items: center;
    overflow: hidden;
  }
  .field .app { transform: rotate(-2.5deg); transition: transform 500ms var(--spring); }
  .field:hover .app { transform: rotate(0deg) scale(1.02); }
  .f-read { grid-column: 7 / 13; grid-row: 2; }
  h2 { grid-column: 7 / 13; grid-row: 1; font-size: var(--s-head); padding: 72px 0 16vh; }
  .h2-second { display: block; --pop: var(--yellow); }
  .h2-second .pop { display: inline-block; transform: rotate(-1.5deg); }
  .block { min-height: 52vh; max-width: 46ch; display: grid; align-content: start; gap: 16px; }
  .block:last-child { min-height: 0; }
  .block > p { font-weight: 500; }
  .title { display: flex; align-items: center; gap: 18px; }
  .title img { width: 84px; flex: 0 0 auto; }
  .block:nth-child(even) .title img { --tilt: 7deg; }
  h3 { font-size: var(--s-lead); line-height: 1.02; }

  /* Controls at interface size */
  .ctl {
    justify-self: start; display: inline-flex; gap: 6px; align-items: center;
    min-height: 48px; padding: 0 22px; border: 0; border-radius: var(--pill);
    background: var(--coral); color: var(--ink); font-weight: 700; font-size: 1.0625rem;
    transition: transform 260ms var(--spring), opacity 160ms;
  }
  .ctl:hover { transform: translateY(-3px) rotate(-2deg) scale(1.04); }
  .ctl:active { transform: scale(0.97); }
  .ctl:disabled { opacity: 0.45; cursor: default; transform: none; }
  .switch {
    justify-self: start; display: inline-flex; align-items: center; gap: 12px;
    min-height: 48px; padding: 0 18px 0 8px; border: 0; border-radius: var(--pill);
    background: var(--paper); font-weight: 700; transition: background-color 160ms, transform 260ms var(--spring);
  }
  .switch:hover { background: var(--paper-deep); transform: rotate(-1.5deg); }
  .knob {
    width: 48px; height: 30px; border-radius: var(--pill); background: #cfccc6; position: relative;
    transition: background-color 200ms;
  }
  .knob::after {
    content: ''; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%;
    background: #fff; transition: transform 220ms var(--ease-out);
  }
  .switch[aria-checked='true'] .knob { background: var(--mint); }
  .switch[aria-checked='true'] { background: #dcf6ec; }
  .switch[aria-checked='true'] .knob::after { transform: translateX(18px); }

  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { font-size: var(--s-small); color: var(--muted); padding: 0; margin-bottom: 8px; }
  .seg, .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .seg legend, .chips legend { width: 100%; float: left; }
  .seg label, .chips label { position: relative; }
  .seg input, .chips input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span, .chips span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border-radius: var(--pill); background: var(--paper); font-weight: 700;
    transition: background-color 160ms, color 160ms, transform 260ms var(--spring);
  }
  .seg label:hover span, .chips label:hover span { transform: rotate(-3deg) scale(1.05); }
  .seg label:hover span, .chips label:hover span { background: var(--paper-deep); }
  .seg input:checked + span { background: var(--yellow); color: var(--ink); }
  .chips input:checked + span { background: var(--coral); color: var(--ink); }
  .seg input:focus-visible + span, .chips input:focus-visible + span { outline: 3px solid var(--ink); outline-offset: 2px; }

  /* The Ordero app screen (design-system components from ds.css) */
  .app { width: min(400px, calc(100% - 40px)); }
  .app-profile { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  [data-allergy-tags] { display: contents; }
  .days { margin: 0; padding: 0; list-style: none; overflow: hidden; }
  .day { transition: background-color 260ms; }
  .day[data-state='ordered'] { background: #f3fcf9; }
  .day[data-state='cancelled'] .dish { text-decoration: line-through; }
  .meal { display: grid; gap: 1px; min-width: 0; }
  .auto-badge { margin-left: 4px; font-size: 11px; padding: 2px 7px; }
  .auto-badge[hidden] { display: none; }
  .log { display: flex; flex-wrap: wrap; gap: 2px 10px; font-size: 12.5px; margin-top: 4px; }
  .log[hidden] { display: none; }
  .log > span { display: inline-flex; align-items: center; gap: 4px; }
  .ok { color: #12634b; }
  .no { color: #b3192a; }
  .app :global(.flash) { animation: flash 700ms var(--ease-out); }
  @keyframes flash { 0% { transform: scale(0.97); } 60% { transform: scale(1.015); } 100% { transform: none; } }

  @media (max-width: 860px) {
    .features { display: block; padding-top: 96px; }
    /* The app stays in view while the controls below it are used. */
    .f-stage { position: sticky; top: 0; z-index: 2; height: 50svh; margin-inline: calc(-1 * var(--gutter)); padding: 8px var(--gutter) 12px; background: var(--bg); }
    .field { position: relative; top: 0; height: 100%; min-height: 0; place-items: start center; padding-top: 14px; }
    .field .app { transform: scale(0.78) rotate(-1.5deg); transform-origin: top center; }
    .field:hover .app { transform: scale(0.78); }
    .title img { width: 64px; }
    .f-read { padding-block: 32px 24px; }
    h2 { padding: 0 0 32px; }
    .h2-second { display: inline; }
    .block { min-height: 0; margin-bottom: 64px; }
  }
</style>
