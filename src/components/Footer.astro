---
import Stores from './Stores.astro';
import { links, type T } from '../i18n/content';
interface Props { t: T; page: keyof T['routes']; photo: { src: string; alt: string; w: number; h: number; pos?: string; credit?: string; creditHref?: string } }
const { t, page, photo } = Astro.props;
const demoHref = `${t.routes[page === 'business' ? 'business' : 'home']}#contact`;
---
<footer class="footer">
  <div class="photo">
    <img src={photo.src} alt={photo.alt} width={photo.w} height={photo.h} loading="lazy" style={photo.pos ? `object-position:${photo.pos}` : undefined} />
  </div>
  <div class="side">
    <a class="wordmark" href={t.routes.home}><img src="/images/logo.webp" alt="Ordero" width="900" height="269" loading="lazy" /></a>
    <nav aria-label={t.nav.products}>
      <ul class="menu" role="list">
        <li><a href={t.routes.home}>{t.nav.kids}</a></li>
        <li><a href={t.routes.business}>{t.nav.business}</a></li>
        <li><a href={demoHref}>{t.nav.demo}</a></li>
        <li><a href={links.login}>{t.nav.login}</a></li>
      </ul>
    </nav>
    <div class="blocks">
      <div>
        <p class="tagline">{t.footer.tagline}</p>
        <Stores size="small" />
      </div>
      <nav aria-labelledby="legal-title">
        <h2 id="legal-title" class="legal-title">{t.footer.legal}</h2>
        <ul role="list">
          <li><a class="link" href={t.routes.terms}>{t.footer.terms}</a></li>
          <li><a class="link" href={t.routes.privacy}>{t.footer.privacy}</a></li>
          <li><a class="link" href={t.routes.businessPrivacy}>{t.footer.businessPrivacy}</a></li>
          <li><a class="link" href={links.linkedin}>LinkedIn</a></li>
        </ul>
      </nav>
    </div>
    <p class="fine">
      <span>{t.footer.copyright}</span>
      {photo.credit && <span>{t.footer.photo}: {photo.creditHref ? <a class="link" href={photo.creditHref}>{photo.credit}</a> : photo.credit}</span>}
    </p>
  </div>
</footer>

<style>
  .footer {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    padding: 0 var(--gutter) var(--gutter);
    min-height: min(100svh, 960px);
  }
  .photo { border-radius: var(--radius); overflow: hidden; background: var(--paper); }
  .photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .footer:hover .photo img { transform: scale(1.03); }
  .side {
    background: var(--paper); border-radius: var(--radius);
    padding: clamp(28px, 4vw, 64px);
    display: grid; grid-template-rows: auto auto 1fr auto; gap: 48px;
  }
  .wordmark { width: 132px; display: block; }
  .menu { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .menu a {
    display: inline-block; font-family: var(--display); font-size: var(--s-head);
    line-height: 1.02; letter-spacing: -0.02em; text-decoration: none;
    transition: transform 240ms var(--ease-out), color 200ms;
  }
  .menu:hover a { color: var(--muted); }
  .menu a:hover, .menu a:focus-visible { color: var(--ink); transform: translateX(12px); }
  .blocks { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-content: end; font-size: 0.9375rem; }
  .blocks ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .tagline { margin-bottom: 18px; max-width: 30ch; }
  .legal-title { font-family: var(--text); font-weight: 600; font-size: 0.9375rem; letter-spacing: 0; margin-bottom: 12px; }
  .fine { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; font-size: var(--s-small); color: var(--muted); }

  @media (max-width: 860px) {
    .footer { grid-template-columns: 1fr; min-height: 0; }
    .photo { height: 50svh; }
    .side { gap: 36px; padding: 32px 20px; }
    .blocks { grid-template-columns: 1fr; }
  }
</style>
