---
import Nav from './Nav.astro';
import Stores from './Stores.astro';
import type { T } from '../i18n/content';

interface Slide { src: string; alt: string; w: number; h: number; fit?: 'cover' | 'contain'; pos?: string }
interface Props {
  t: T;
  page: 'home' | 'business';
  h1: string[];
  lead: string;
  cta: { label: string; href: string };
  field: 'yellow' | 'mint';
  slides: Slide[];
  stickers?: string[];
}
const { t, page, h1, lead, cta, field, slides, stickers = [] } = Astro.props;
// Bricolage 800 runs about 0.5em per character.
const fitEm = (Math.max(...h1.map((l) => l.length)) * 0.5 + 0.4).toFixed(2);
const spots = [
  { tilt: '-10deg', style: 'left:3.5%;top:4%', delay: '0s' },
  { tilt: '8deg', style: 'right:4%;bottom:5%', delay: '-3s' },
];
const street = t.contact.addresses[0].split(',').slice(1, 3).join(',').trim();
---
<header class={`hero field-${field}`}>
  <a class="skip" href="#main">{t.skip}</a>
  <div class="nav-row"><Nav t={t} page={page} /></div>
  <div class="sheet">
    {stickers.map((ill, i) => (
      <span class="spot float" style={`${spots[i].style};--delay:${spots[i].delay}`} aria-hidden="true">
        <img class="sticker" src={`/images/${ill}`} alt="" width="560" height="560" style={`--tilt:${spots[i].tilt}`} />
      </span>
    ))}
    <div class="intro">
      <h1 data-reveal style={`--i:0;--fit-em:${fitEm}`} data-fit data-fit-min="30" data-fit-lines="3">
        {h1.map((line, i) => <span class="line">{i === h1.length - 1 ? <span class="pop">{line}</span> : line}{i < h1.length - 1 ? ' ' : ''}</span>)}
      </h1>
      <p class="lead" data-reveal style="--i:1">{lead}</p>
      <p data-reveal style="--i:2">
        <a class="btn" href={cta.href}>{cta.label}<span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
  <div class="stage" data-crossfade>
    {slides.map((s, i) => (
      <img
        class={`slide fit-${s.fit ?? 'cover'}`}
        src={s.src} alt={i === 0 ? s.alt : ''} aria-hidden={i === 0 ? undefined : 'true'}
        width={s.w} height={s.h}
        style={s.pos ? `object-position:${s.pos}` : undefined}
        loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined}
        data-active={i === 0 ? '' : undefined}
      />
    ))}
    <div class="bar">
      <Stores size="small" />
      <span class="street">{street}</span>
    </div>
  </div>
</header>

<script>
  // Stickers never sit on text: hide any that would overlap the headline, lead or button.
  const guard = () => document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
    const rects = [...hero.querySelectorAll('h1 .line, .lead, .btn')].flatMap((el) => {
      const r = document.createRange(); r.selectNodeContents(el); return [...r.getClientRects()];
    });
    hero.querySelectorAll<HTMLElement>('.spot').forEach((spot) => {
      spot.style.visibility = '';
      const s = spot.getBoundingClientRect();
      const m = 16; // room for the gentle float
      const hit = rects.some((h) => !(s.right + m < h.left || s.left - m > h.right || s.bottom + m < h.top || s.top - m > h.bottom));
      if (hit) spot.style.visibility = 'hidden';
    });
  });
  guard();
  document.fonts?.ready.then(() => setTimeout(guard, 150));
  setTimeout(guard, 1300); // after the entrance has settled
  window.addEventListener('resize', () => setTimeout(guard, 200));

  // Signature move: the stage's pictures crossfade slowly, like light shifting.
  const stages = document.querySelectorAll<HTMLElement>('[data-crossfade]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  stages.forEach((stage) => {
    const slides = [...stage.querySelectorAll<HTMLImageElement>('.slide')];
    if (slides.length < 2 || reduce) return;
    let i = 0;
    let timer = 0;
    const next = () => {
      slides[i].removeAttribute('data-active');
      i = (i + 1) % slides.length;
      slides[i].setAttribute('data-active', '');
    };
    const start = () => { stop(); timer = window.setInterval(next, 5600); };
    const stop = () => window.clearInterval(timer);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 12px;
    padding: 0 var(--gutter) var(--gutter);
    min-height: min(100svh, 1040px);
    position: relative;
  }
  .nav-row { grid-column: 1 / -1; padding-block: 4px 8px; }
  .sheet {
    position: relative;
    border-radius: var(--radius);
    padding: 0 clamp(20px, 2.4vw, 40px);
    display: grid;
  }
  /* The sheet takes the other brand colour from the stage. */
  .field-yellow .sheet, .field-yellow .intro { background: var(--mint); }
  .field-mint .sheet, .field-mint .intro { background: var(--yellow); }
  .field-yellow { --pop: var(--yellow); }
  .field-mint { --pop: var(--coral); }
  .spot { position: absolute; width: clamp(72px, 7.5vw, 136px); z-index: 1; }
  .sheet:has(.spot) .intro { padding-top: clamp(136px, 17vh, 184px); padding-bottom: clamp(120px, 15vh, 176px); }
  @media (max-width: 1100px) { .spot { display: none; } .sheet:has(.spot) .intro { padding-block: 64px; } }
  .spot img { width: 100%; }
  .intro {
    container-type: inline-size;
    align-self: center;
    text-align: center;
    display: grid; justify-items: center; gap: 28px;
    padding-block: clamp(48px, 8vh, 112px) clamp(56px, 12vh, 160px);
  }
  h1 {
    font-size: clamp(2.75rem, calc(100cqi / var(--fit-em, 19) * 1.5), 5rem);
    line-height: 1.02;
    max-width: 100%;
  }
  h1 .line { display: block; }
  h1 .pop { display: inline-block; transform: rotate(-1.5deg); margin-top: 0.06em; }
  .lead { max-width: 44ch; color: var(--ink); font-size: var(--s-body); font-weight: 500; }

  .stage {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    min-height: 520px;
  }
  .field-yellow .stage { background: var(--yellow); }
  .field-mint .stage { background: var(--mint); }
  .slide {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; transition: opacity 1600ms ease-in-out, transform 7s ease-out;
    transform: scale(1.04);
  }
  .slide[data-active] { opacity: 1; transform: scale(1); }
  .fit-cover { object-fit: cover; }
  .fit-contain { object-fit: contain; padding: 6% 8% 64px; object-position: 50% 100%; }
  .bar {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    min-height: 64px; padding: 8px 16px 8px 12px;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    background: #fff;
    font-size: 0.9375rem; font-weight: 600;
  }

  @media (max-width: 860px) {
    .hero {
      display: flex; flex-direction: column; gap: 0;
      padding: 0 var(--gutter) var(--gutter);
      min-height: 0;
    }
    .sheet { display: contents; }
    .spot { display: none; }
    .nav-row { order: 0; padding-block: 4px; }
    h1 .line { white-space: normal; }
    h1 .pop { display: inline; transform: none; }
    .stage {
      order: 1; position: sticky; top: 0; z-index: 0;
      min-height: 0; height: 56svh;
    }
    .bar { display: none; }
    .intro {
      order: 2; position: relative; z-index: 1; align-self: stretch;
      border-radius: var(--radius);
      margin-top: -64px; padding: 40px 20px 36px;
      gap: 22px;
    }
    h1 { font-size: clamp(2.125rem, 9vw, 3rem); }
    .intro .btn { width: 100%; }
    .intro p:last-child { width: 100%; }
    .fit-contain { padding: 6% 8% 0; }
  }
</style>
