---
import { langs, routes, links, type T } from '../i18n/content';
interface Props { t: T; page: keyof T['routes'] }
const { t, page } = Astro.props;
const label = { lt: 'LT', en: 'EN', pl: 'PL' } as const;
const langName = { lt: 'Lietuvių', en: 'English', pl: 'Polski' } as const;
---
<nav class="nav" aria-label="Ordero">
  <ul class="nav-products" role="list" aria-label={t.nav.products}>
    <li><a href={t.routes.home} aria-current={page === 'home' ? 'page' : undefined}>{t.nav.kids}</a></li>
    <li><a href={t.routes.business} aria-current={page === 'business' ? 'page' : undefined}>{t.nav.business}</a></li>
  </ul>
  <a class="wordmark" href={t.routes.home}>
    <img src="/images/logo.svg" alt="Ordero" width="121" height="36" />
  </a>
  <ul class="nav-actions" role="list">
    <li><a href={`${t.routes[page === 'business' ? 'business' : 'home']}#contact`}>{t.nav.demo}</a></li>
    <li><a class="login" href={links.login}>{t.nav.login}</a></li>
    <li class="langs">
      {langs.map((l) => (
        <a href={routes[l][page]} lang={l} hreflang={l} aria-label={langName[l]} aria-current={l === t.lang ? 'true' : undefined}>{label[l]}</a>
      ))}
    </li>
  </ul>
  <details class="menu">
    <summary><span>{t.nav.menu}</span></summary>
    <div class="menu-panel">
      <ul role="list" aria-label={t.nav.products}>
        <li><a href={t.routes.home}>{t.nav.kids}</a></li>
        <li><a href={t.routes.business}>{t.nav.business}</a></li>
        <li><a href={`${t.routes[page === 'business' ? 'business' : 'home']}#contact`}>{t.nav.demo}</a></li>
        <li><a href={links.login}>{t.nav.login}</a></li>
      </ul>
      <p class="menu-langs">
        {langs.map((l) => (
          <a href={routes[l][page]} lang={l} hreflang={l} aria-label={langName[l]} aria-current={l === t.lang ? 'true' : undefined}>{label[l]}</a>
        ))}
      </p>
    </div>
  </details>
</nav>

<style>
  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    min-height: 72px;
    font-size: 1rem; font-weight: 600;
  }
  .nav ul { display: flex; gap: 22px; align-items: center; margin: 0; padding: 0; list-style: none; }
  .nav-actions { justify-content: flex-end; }
  .nav a { text-decoration: none; transition: color 160ms; }
  .nav-products a, .nav-actions > li > a:not(.login) { position: relative; padding-block: 6px; }
  .nav-products a::after, .nav-actions > li > a:not(.login)::after {
    content: ''; position: absolute; left: -2px; right: -2px; bottom: 0; height: 5px; border-radius: 5px;
    background: var(--coral); transform: scaleX(0) rotate(-2deg); transform-origin: left;
    transition: transform 320ms var(--spring); z-index: -1;
  }
  .nav-products a:hover::after, .nav-actions > li > a:not(.login):hover::after,
  .nav-products a[aria-current='page']::after { transform: scaleX(1) rotate(-2deg); }
  .wordmark { display: block; width: clamp(128px, 11vw, 168px); transition: transform 240ms var(--ease-out); }
  .wordmark { transition: transform 420ms var(--spring); }
  .wordmark:hover { transform: rotate(-4deg) scale(1.05); }
  .wordmark img { width: 100%; height: auto; }
  .login {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px;
    border-radius: var(--pill); background: var(--ink); color: #fff;
    transition: transform 180ms var(--ease-out);
  }
  .login:hover { transform: translateY(-1px); }
  .langs { display: flex; gap: 2px; }
  .langs a, .menu-langs a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 34px; min-height: 34px; border-radius: var(--pill);
    font-size: var(--s-small); color: var(--muted);
  }
  .langs a:hover, .menu-langs a:hover { color: var(--ink); background: var(--paper-deep); }
  .langs a[aria-current='true'], .menu-langs a[aria-current='true'] { color: var(--ink); font-weight: 600; }

  .menu { display: none; justify-self: end; position: relative; }
  .menu summary {
    list-style: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border-radius: var(--pill); background: var(--ink); color: #fff; cursor: pointer; font-weight: 500;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 50;
    width: min(320px, calc(100vw - 2 * var(--gutter)));
    background: var(--ink); color: #fff; border-radius: var(--radius); padding: 20px 24px 16px;
  }
  .menu-panel ul { display: grid; gap: 4px; }
  .menu-panel ul a { display: block; padding: 10px 0; font-size: 1.25rem; }
  .menu-langs { display: flex; gap: 4px; margin-top: 12px; }
  .menu-langs a { color: #cfccc6; }
  .menu-langs a[aria-current='true'] { color: #fff; }
  .menu-langs a:hover { color: var(--ink); }

  @media (max-width: 1080px) {
    .nav { grid-template-columns: auto 1fr; }
    .nav-products, .nav-actions { display: none !important; }
    .wordmark { grid-column: 1; }
    .menu { display: block; grid-column: 2; }
  }
</style>
