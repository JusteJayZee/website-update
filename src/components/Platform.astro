---
import type { T } from '../i18n/content';
import { splitHeading } from '../i18n/split';
interface Props { t: T }
const { t } = Astro.props;
const p = t.kids.platform;
const d = p.diagram;
const ui = t.ui;
const keys = ['caterer', 'parents', 'school'] as const;
const [h2a, h2b] = splitHeading(p.h2);
const totals = ui.reportRows.reduce((a, r) => [a[0] + (r[1] as number), a[1] + (r[2] as number)], [0, 0]);
---
<section class="platform" id="platform" aria-labelledby="platform-title">
  <div class="intro wrap">
    <h2 id="platform-title" data-reveal data-fit>{h2a} {h2b && <span class="pop">{h2b}</span>}</h2>
    <p data-reveal style="--i:1">{p.lead}</p>
  </div>

  <div class="show wrap">
    <div class="index" role="tablist" aria-label={p.h2}>
      {keys.map((k, i) => (
        <button
          type="button" role="tab" id={`tab-${k}`} aria-controls={`sheet-${k}`}
          aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          data-reveal style={`--i:${i}`}
        >
          <img src={`/images/ill/${k}.webp`} alt="" width="560" height="500" loading="lazy" />
          <span class="name">{p.items[k][0]}</span>
          <span class="desc">{p.items[k][1]}</span>
        </button>
      ))}
    </div>

    <div class="stage" data-reveal style="--i:2">
      <!-- Caterer: the menu -->
      <article class="sheet ds-screen" id="sheet-caterer" role="tabpanel" aria-labelledby="tab-caterer" data-ui>
        <p class="flow"><b>{d.caterer}</b> → Ordero · {d.offerings}</p>
        <p class="flow"><b>{d.caterer}</b> → <b>{d.school}</b> · {d.delivery}</p>
        <h3>{ui.menuTitle}</h3>
        <div class="menu-days">
          {ui.menu.map((row) => (
            <div class="ds-card menu-day">
              <p class="menu-day-name">{row[0]}</p>
              <div class="ds-row"><img class="ds-meal" src="/images/ds/egg.svg" alt="" width="32" height="32" /><span><span class="ds-row-title">{ui.breakfast}</span><span class="ds-row-sub">{row[1]}</span></span><span class="ds-price">2,00 €</span></div>
              <div class="ds-row"><img class="ds-meal" src="/images/ds/taco.svg" alt="" width="32" height="32" /><span><span class="ds-row-title">{ui.lunch}</span><span class="ds-row-sub">{row[2]}</span></span><span class="ds-price">5,00 €</span></div>
            </div>
          ))}
        </div>
      </article>

      <!-- Parents: the order (Order lines) -->
      <article class="sheet ds-screen sheet-narrow" id="sheet-parents" role="tabpanel" aria-labelledby="tab-parents" data-ui hidden>
        <p class="flow"><b>{d.parents}</b> → Ordero · {d.orders}</p>
        <h3>{ui.orderTitle}</h3>
        <div class="ds-card receipt">
          <table class="ds-lines">
            <tbody>
              {ui.orderLines.map((l) => (
                <tr class={l[3] === 'cancel' ? 'cancelled' : ''}>
                  <td><span class="item"><img src="/images/ds/taco.svg" alt="" width="26" height="26" /><span>{l[0]} · {l[1]}<small>{ui.regular}</small></span></span></td>
                  <td class="num">1</td>
                  <td class="num">{l[2]}</td>
                </tr>
              ))}
              <tr class="grand"><td colspan="2">{ui.total}</td><td class="num">{ui.orderTotal}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="paid"><span class="ds-pill ds-pill-positive">{ui.paid}</span><span class="ds-pill ds-pill-negative">{ui.days[2]} · {ui.cancelled}</span></p>
      </article>

      <!-- School: the daily report (Stat cards + list) -->
      <article class="sheet ds-screen" id="sheet-school" role="tabpanel" aria-labelledby="tab-school" data-ui hidden>
        <p class="flow">Ordero → <b>{d.school}</b> · {d.report}</p>
        <h3>{ui.reportTitle}</h3>
        <div class="stats">
          <div class="ds-card ds-stat"><span class="ds-stat-icon" style="background:#f8d388"><img src="/images/ds/egg.svg" alt="" width="26" height="26" /></span><b>{ui.breakfast}</b><span class="big">{totals[0]}</span></div>
          <div class="ds-card ds-stat"><span class="ds-stat-icon" style="background:#aef9c0"><img src="/images/ds/taco.svg" alt="" width="26" height="26" /></span><b>{ui.lunch}</b><span class="big">{totals[1]}</span></div>
        </div>
        <div class="ds-card">
          <table class="ds-lines report">
            <thead><tr>{ui.reportCols.map((c, i) => <th scope="col" class={i ? 'num' : ''}>{c}</th>)}</tr></thead>
            <tbody>
              {ui.reportRows.map((r) => (
                <tr><td><b>{r[0]}</b></td><td class="num">{r[1]}</td><td class="num">{r[2]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="paid"><span class="ds-pill ds-pill-negative">{ui.reportNotes}</span></p>
      </article>
    </div>
  </div>

  <div class="figures">
    <dl class="wrap">
      {t.kids.stats.map((s, i) => (
        <div data-reveal style={`--i:${i}`}>
          <dt style={`--tilt:${i % 2 ? 3 : -3}deg`}>{s[0]}</dt>
          <dd>{s[1]}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.platform').forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = section.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'));
        if (panel) {
          panel.hidden = !on;
          if (on) { panel.classList.remove('enter'); void panel.offsetWidth; panel.classList.add('enter'); }
        }
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(tabs[(i + dir + tabs.length) % tabs.length], true);
      });
    });
  });
</script>

<style>
  .platform { padding-top: var(--section); }
  .intro {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    align-items: end; row-gap: 20px; margin-bottom: clamp(48px, 6vw, 88px);
  }
  .intro h2 { grid-column: 1 / 8; font-size: var(--s-head); max-width: 16ch; }
  .intro p { grid-column: 8 / -1; max-width: 46ch; }

  .show { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .index { grid-column: 1 / 6; display: grid; align-content: start; gap: 10px; }
  [role='tab'] {
    display: grid; grid-template-columns: 76px 1fr; column-gap: 20px; row-gap: 6px; align-items: center;
    text-align: left; padding: 18px 20px 18px 12px; border: 0; border-radius: var(--radius);
    background: transparent; color: var(--ink);
    transition: background-color 200ms, transform 300ms var(--spring);
  }
  [role='tab'] img { grid-row: 1 / span 2; width: 76px; height: 76px; object-fit: contain; transform: rotate(-6deg) scale(0.86); transition: transform 400ms var(--spring); }
  .name { font-family: var(--display); font-weight: 800; font-size: var(--s-lead); line-height: 1; letter-spacing: -0.025em; }
  .desc { font-size: var(--s-small); font-weight: 500; max-width: 40ch; }
  [role='tab']:hover { background: var(--paper); }
  [role='tab']:hover img { transform: rotate(6deg) scale(1); }
  [role='tab'][aria-selected='true'] { background: var(--yellow); transform: rotate(-1deg); }
  [role='tab'][aria-selected='true'] img { transform: rotate(-8deg) scale(1.12); }

  .stage {
    grid-column: 6 / 13; position: relative;
    background: var(--yellow); border-radius: var(--radius);
    height: 600px; overflow: hidden;
    padding: 64px 0 0 clamp(24px, 4vw, 64px);
  }
  .sheet { width: 600px; max-width: none; min-height: 100%; border-radius: 28px 28px 0 0; padding: 22px 20px 40px; box-shadow: none; }
  .sheet-narrow { width: 460px; }
  .sheet[hidden] { display: none; }
  .sheet:global(.enter) { animation: sheet-in 420ms var(--ease-out); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  .flow { font-size: 13px; color: var(--ds-text-2); }
  .flow b { color: var(--ds-text); }
  .sheet h3 { font-family: 'Nunito Sans', sans-serif; font-size: 19px; font-weight: 800; letter-spacing: 0; margin: 14px 0 12px; }
  .menu-days { display: grid; gap: 10px; }
  .menu-day-name { padding: 10px 14px 0; font-weight: 800; font-size: 13px; color: var(--ds-text-2); }
  .menu-day .ds-row { grid-template-columns: 32px 1fr auto; }
  .menu-day .ds-row + .ds-row { border-top: 1px solid var(--ds-border); }
  .receipt { padding: 4px 16px 8px; }
  .report { padding: 0; }
  .ds-card:has(> .report) { padding: 4px 16px 6px; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
  .paid { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }

  .figures { margin-top: clamp(80px, 9vw, 144px); background: var(--ink); color: #fff; padding-block: clamp(80px, 9vw, 144px); }
  dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  dl div { display: grid; align-content: start; gap: 14px; }
  dt {
    justify-self: start; font-family: var(--display); font-weight: 800; font-size: var(--s-display); line-height: 0.9; letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums; color: var(--yellow); white-space: nowrap;
    transform: rotate(var(--tilt)); transition: transform 400ms var(--spring);
  }
  dl div:hover dt { transform: rotate(0deg) scale(1.06); }
  dl div:nth-child(2) dt { color: var(--mint); }
  dl div:nth-child(3) dt { color: var(--coral); }
  dl div:nth-child(4) dt { color: #fff; }
  dd { font-weight: 500; }
  dd { max-width: 22ch; font-size: var(--s-body); }

  @media (max-width: 1080px) {
    .intro h2, .intro p { grid-column: 1 / -1; }
    .index, .stage { grid-column: 1 / -1; }
    .index { margin-bottom: 16px; gap: 4px; }
    .stage { height: 72svh; min-height: 480px; padding: 20px 0 0 16px; }
    dl { grid-template-columns: 1fr 1fr; row-gap: 56px; }
  }
  @media (max-width: 560px) {
    [role='tab'] { grid-template-columns: 56px 1fr; column-gap: 14px; }
    [role='tab'] img { width: 56px; height: 56px; }
    .sheet { width: 520px; padding: 22px 20px 40px; }
    .sheet-narrow { width: 380px; }
    dt { font-size: var(--s-head); }
  }
</style>
