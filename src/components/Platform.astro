---
import type { T } from '../i18n/content';
interface Props { t: T }
const { t } = Astro.props;
const p = t.kids.platform;
const d = p.diagram;
const ui = t.ui;
const keys = ['caterer', 'parents', 'school'] as const;
const totals = ui.reportRows.reduce((a, r) => [a[0] + (r[1] as number), a[1] + (r[2] as number)], [0, 0]);
---
<section class="platform" id="platform" aria-labelledby="platform-title">
  <div class="intro wrap">
    <h2 id="platform-title" data-reveal data-fit>{p.h2}</h2>
    <p data-reveal style="--i:1">{p.lead}</p>
  </div>

  <div class="show wrap">
    <div class="index" role="tablist" aria-label={p.h2}>
      {keys.map((k, i) => (
        <button
          type="button" role="tab" id={`tab-${k}`} aria-controls={`sheet-${k}`}
          aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          data-reveal style={`--i:${i}`}
        >
          <img src={`/images/ill/${k}.webp`} alt="" width="560" height="500" loading="lazy" />
          <span class="name">{p.items[k][0]}</span>
          <span class="desc">{p.items[k][1]}</span>
        </button>
      ))}
    </div>

    <div class="stage" data-reveal style="--i:2">
      <!-- Caterer: the menu -->
      <article class="sheet" id="sheet-caterer" role="tabpanel" aria-labelledby="tab-caterer" data-ui>
        <p class="flow"><b>{d.caterer}</b> <span aria-hidden="true">→</span> Ordero · <span>{d.offerings}</span></p>
        <p class="flow flow-2"><b>{d.caterer}</b> <span aria-hidden="true">→</span> <b>{d.school}</b> · <span>{d.delivery}</span></p>
        <h3>{ui.menuTitle}</h3>
        <table>
          <thead><tr><th scope="col"></th><th scope="col">{ui.breakfast}</th><th scope="col">{ui.lunch}</th></tr></thead>
          <tbody>
            {ui.menu.map((row) => (
              <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>
            ))}
          </tbody>
        </table>
      </article>

      <!-- Parents: the order -->
      <article class="sheet sheet-narrow" id="sheet-parents" role="tabpanel" aria-labelledby="tab-parents" data-ui hidden>
        <p class="flow"><b>{d.parents}</b> <span aria-hidden="true">→</span> Ordero · <span>{d.orders}</span></p>
        <h3>{ui.orderTitle}</h3>
        <table>
          <tbody>
            {ui.orderLines.map((l) => (
              <tr class={l[3] === 'cancel' ? 'cancelled' : ''}>
                <th scope="row">{l[0]}</th><td>{l[1]}</td>
                <td class="num">{l[3] === 'cancel' ? ui.cancelled : l[2]}</td>
              </tr>
            ))}
          </tbody>
          <tfoot><tr><th scope="row" colspan="2">{ui.total}</th><td class="num">{ui.orderTotal}</td></tr></tfoot>
        </table>
        <p class="paid"><svg class="ico" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> {ui.paid}</p>
      </article>

      <!-- School: the daily report -->
      <article class="sheet" id="sheet-school" role="tabpanel" aria-labelledby="tab-school" data-ui hidden>
        <p class="flow">Ordero <span aria-hidden="true">→</span> <b>{d.school}</b> · <span>{d.report}</span></p>
        <h3>{ui.reportTitle}</h3>
        <table>
          <thead><tr>{ui.reportCols.map((c, i) => <th scope="col" class={i ? 'num' : ''}>{c}</th>)}</tr></thead>
          <tbody>
            {ui.reportRows.map((r) => (
              <tr><th scope="row">{r[0]}</th><td class="num">{r[1]}</td><td class="num">{r[2]}</td></tr>
            ))}
          </tbody>
          <tfoot><tr><th scope="row">{ui.total}</th><td class="num">{totals[0]}</td><td class="num">{totals[1]}</td></tr></tfoot>
        </table>
        <p class="note">{ui.reportNotes}</p>
      </article>
    </div>
  </div>

  <div class="figures">
    <dl class="wrap">
      {t.kids.stats.map((s, i) => (
        <div data-reveal style={`--i:${i}`}>
          <dt>{s[0]}</dt>
          <dd>{s[1]}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.platform').forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = section.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'));
        if (panel) {
          panel.hidden = !on;
          if (on) { panel.classList.remove('enter'); void panel.offsetWidth; panel.classList.add('enter'); }
        }
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        select(tabs[(i + dir + tabs.length) % tabs.length], true);
      });
    });
  });
</script>

<style>
  .platform { padding-top: var(--section); }
  .intro {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    align-items: end; row-gap: 20px; margin-bottom: clamp(48px, 6vw, 88px);
  }
  .intro h2 { grid-column: 1 / 8; font-size: var(--s-head); max-width: 16ch; }
  .intro p { grid-column: 8 / -1; max-width: 46ch; }

  .show { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .index { grid-column: 1 / 6; display: grid; align-content: start; gap: 10px; }
  [role='tab'] {
    display: grid; grid-template-columns: 76px 1fr; column-gap: 20px; row-gap: 6px; align-items: center;
    text-align: left; padding: 18px 20px 18px 12px; border: 0; border-radius: var(--radius);
    background: transparent; color: var(--muted);
    transition: background-color 200ms, color 200ms;
  }
  [role='tab'] img { grid-row: 1 / span 2; width: 76px; height: 76px; object-fit: contain; filter: grayscale(1); opacity: 0.55; transition: filter 300ms, opacity 300ms, transform 300ms var(--ease-out); }
  .name { font-family: var(--display); font-size: var(--s-lead); line-height: 1; letter-spacing: -0.015em; }
  .desc { font-size: var(--s-small); max-width: 40ch; }
  [role='tab']:hover { color: var(--ink); background: var(--paper); }
  [role='tab'][aria-selected='true'] { color: var(--ink); background: var(--paper); }
  [role='tab'][aria-selected='true'] img, [role='tab']:hover img { filter: none; opacity: 1; transform: rotate(-4deg) scale(1.06); }

  .stage {
    grid-column: 6 / 13; position: relative;
    background: var(--paper); border-radius: var(--radius);
    height: 600px; overflow: hidden;
    padding: 64px 0 0 clamp(24px, 4vw, 64px);
  }
  .sheet {
    width: 600px; max-width: none; background: #fff; border-radius: 14px 14px 0 0;
    padding: 28px 32px 48px; font-size: 15px; line-height: 1.4;
    min-height: 100%;
  }
  .sheet-narrow { width: 440px; }
  .sheet[hidden] { display: none; }
  .sheet:global(.enter) { animation: sheet-in 420ms var(--ease-out); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  .flow { font-size: 13.5px; color: #555; margin-bottom: 4px; }
  .flow b { color: var(--ink); font-weight: 600; }
  .flow-2 { margin-bottom: 0; }
  .sheet h3 { font-size: 20px; font-weight: 600; margin: 18px 0 14px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; vertical-align: top; padding: 10px 8px; border-bottom: 1px solid #ececec; }
  thead th { font-size: 13px; color: #6f6f6f; font-weight: 500; }
  tbody th { font-weight: 600; width: 52px; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  tfoot th, tfoot td { font-weight: 600; border-bottom: 0; padding-top: 14px; }
  .cancelled th, .cancelled td { color: #a1121f; }
  .cancelled td:nth-child(2) { text-decoration: line-through; }
  .paid { margin-top: 18px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; background: var(--app-green); color: #1d3b12; font-weight: 600; font-size: 13.5px; }
  .note { margin-top: 18px; font-size: 13.5px; background: #ffe3e6; color: #a1121f; display: inline-block; padding: 4px 12px; border-radius: 999px; }

  .figures { margin-top: clamp(80px, 9vw, 144px); background: var(--ink); color: #fff; padding-block: clamp(80px, 9vw, 144px); }
  dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  dl div { display: grid; align-content: start; gap: 14px; }
  dt { font-family: var(--display); font-size: var(--s-display); line-height: 0.9; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--yellow); white-space: nowrap; }
  dd { max-width: 22ch; font-size: var(--s-body); }

  @media (max-width: 1080px) {
    .intro h2, .intro p { grid-column: 1 / -1; }
    .index, .stage { grid-column: 1 / -1; }
    .index { margin-bottom: 16px; gap: 4px; }
    .stage { height: 72svh; min-height: 480px; padding: 20px 0 0 16px; }
    dl { grid-template-columns: 1fr 1fr; row-gap: 56px; }
  }
  @media (max-width: 560px) {
    [role='tab'] { grid-template-columns: 56px 1fr; column-gap: 14px; }
    [role='tab'] img { width: 56px; height: 56px; }
    .sheet { width: 520px; padding: 22px 20px 40px; }
    .sheet-narrow { width: 380px; }
    dt { font-size: var(--s-head); }
  }
</style>
