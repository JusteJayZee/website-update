---
interface Item { name: string; role: string; quote: string }
interface Props { h2: string; items: Item[] }
const { h2, items } = Astro.props;
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
const tones = ['var(--yellow)', 'var(--mint)', 'var(--coral)'];
const [first, ...replies] = items;
---
<section class="quotes wrap" aria-labelledby="quotes-title">
  <h2 id="quotes-title" data-reveal data-fit>{h2}</h2>
  <div class="thread">
    <figure class="comment big" data-ui data-reveal style="--i:1">
      <figcaption>
        <span class="disc" style={`background:${tones[0]}`} aria-hidden="true">{initials(first.name)}</span>
        <span><b>{first.name}</b> · {first.role}</span>
      </figcaption>
      <blockquote><p>{first.quote}</p></blockquote>
    </figure>
    <div class="replies">
      {replies.map((r, i) => (
        <figure class="comment" data-ui data-reveal style={`--i:${i + 2}`}>
          <figcaption>
            <span class="disc" style={`background:${tones[i + 1]}`} aria-hidden="true">{initials(r.name)}</span>
            <span><b>{r.name}</b> · {r.role}</span>
          </figcaption>
          <blockquote><p>{r.quote}</p></blockquote>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes {
    padding-top: var(--section);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
  }
  h2 { grid-column: 1 / 10; font-size: var(--s-head); max-width: 24ch; margin-bottom: clamp(40px, 5vw, 80px); }
  .thread { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 40px; }
  .comment { margin: 0; }
  .big {
    grid-column: 1 / 9;
    background: var(--paper); border-radius: var(--radius);
    padding: clamp(24px, 3vw, 48px);
  }
  figcaption { display: flex; align-items: center; gap: 14px; font-size: 1rem; margin-bottom: 20px; }
  .big figcaption { font-size: 1.0625rem; }
  .disc {
    flex: 0 0 auto; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font-weight: 600; font-size: 0.9375rem; color: var(--ink);
  }
  .big .disc { width: 56px; height: 56px; font-size: 1.0625rem; }
  blockquote { margin: 0; }
  .big blockquote p {
    font-family: var(--display); font-size: var(--s-lead); line-height: 1.16; letter-spacing: -0.01em;
  }
  .replies { grid-column: 9 / 13; display: grid; align-content: start; gap: 24px; }
  .replies .comment { background: var(--paper); border-radius: var(--radius); padding: 24px; }
  .replies blockquote p { font-size: 1.0625rem; }

  @media (max-width: 1080px) {
    h2 { grid-column: 1 / -1; }
    .big { grid-column: 1 / -1; }
    .replies { grid-column: 2 / -1; }
  }
  @media (max-width: 640px) {
    .replies { grid-column: 1 / -1; padding-left: 20px; }
    .big blockquote p { font-size: 1.375rem; }
  }
</style>
