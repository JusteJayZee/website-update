---
interface Item { name: string; role: string; quote: string }
interface Props { h2: string; items: Item[] }
const { h2, items } = Astro.props;
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
const tones = ['var(--yellow)', 'var(--mint)', '#ffd2d6'];
const [first, ...replies] = items;
import { splitHeading } from '../i18n/split';
const [h2a, h2b] = splitHeading(h2);
---
<section class="quotes wrap" aria-labelledby="quotes-title">
  <h2 id="quotes-title" data-reveal data-fit>{h2a} {h2b && <span class="pop">{h2b}</span>}</h2>
  <div class="thread">
    <figure class="comment big" data-reveal style="--i:1">
      <blockquote class="bubble" style={`--b:${tones[0]};--tilt:-1.2deg`}><p>{first.quote}</p></blockquote>
      <figcaption>
        <span class="disc" aria-hidden="true">{initials(first.name)}</span>
        <span><b>{first.name}</b> · {first.role}</span>
      </figcaption>
    </figure>
    <div class="replies">
      {replies.map((r, i) => (
        <figure class="comment" data-reveal style={`--i:${i + 2}`}>
          <blockquote class="bubble" style={`--b:${tones[i + 1]};--tilt:${i ? -1.5 : 1.5}deg`}><p>{r.quote}</p></blockquote>
          <figcaption>
            <span class="disc" aria-hidden="true">{initials(r.name)}</span>
            <span><b>{r.name}</b> · {r.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes {
    padding-top: var(--section);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
  }
  h2 { grid-column: 1 / 10; font-size: var(--s-head); max-width: 24ch; margin-bottom: clamp(40px, 5vw, 80px); }
  .thread { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 40px; }
  .comment { margin: 0; }
  .big { grid-column: 1 / 9; }
  .bubble {
    position: relative; margin: 0 0 22px;
    background: var(--b); border-radius: var(--radius);
    padding: clamp(24px, 3vw, 44px);
    transform: rotate(var(--tilt)); transition: transform 420ms var(--spring);
  }
  .comment:hover .bubble { transform: rotate(0deg) scale(1.01); }
  /* The speech-bubble tail points at the speaker */
  .bubble::after {
    content: ''; position: absolute; left: 34px; bottom: -14px; width: 32px; height: 32px;
    background: var(--b); border-radius: 0 0 8px 0; transform: rotate(45deg) skew(8deg, 8deg);
  }
  .bubble p { font-weight: 500; }
  .big .bubble p { font-family: var(--display); font-weight: 700; font-size: var(--s-lead); line-height: 1.18; letter-spacing: -0.015em; }
  figcaption { display: flex; align-items: center; gap: 12px; font-size: 1rem; padding-left: 20px; }
  .disc {
    flex: 0 0 auto; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--ink); color: #fff; font-weight: 700; font-size: 0.9375rem;
  }
  .big .disc { width: 60px; height: 60px; font-size: 1.125rem; }
  .replies { grid-column: 9 / 13; display: grid; align-content: start; gap: 32px; }
  .replies .bubble { padding: 24px; }

  @media (max-width: 1080px) {
    h2 { grid-column: 1 / -1; }
    .big { grid-column: 1 / -1; }
    .replies { grid-column: 2 / -1; }
  }
  @media (max-width: 640px) {
    .replies { grid-column: 1 / -1; padding-left: 20px; }
    .big .bubble p { font-size: 1.375rem; }
  }
</style>
