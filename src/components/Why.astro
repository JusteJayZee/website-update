---
interface Props { h2: string; items: string[][]; ills: string[]; stats: string[][] }
const { h2, items, ills, stats } = Astro.props;
---
<section class="why" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <h2 id="why-title" data-reveal data-fit>{h2}</h2>
    <ul class="rows" role="list">
      {items.map((it, i) => (
        <li class="row">
          <img src={`/images/ill/${ills[i]}.webp`} alt="" width="560" height="560" loading="lazy" data-reveal />
          <h3 data-reveal style="--i:1" data-fit>{it[0]}</h3>
          <p data-reveal style="--i:2">{it[1]}</p>
        </li>
      ))}
    </ul>
  </div>
  <div class="figures">
    <dl class="wrap">
      {stats.map((s, i) => (
        <div data-reveal style={`--i:${i}`}>
          <dt>{s[0]}</dt>
          <dd>{s[1]}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .why { padding-top: var(--section); }
  h2 { font-size: var(--s-head); margin-bottom: clamp(40px, 5vw, 80px); max-width: 14ch; }
  .rows { display: grid; gap: clamp(48px, 6vw, 96px); margin: 0; padding: 0; list-style: none; }
  .row {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center;
  }
  .row img { grid-column: 1 / 3; width: 100%; max-width: 150px; height: auto; transition: transform 400ms var(--ease-out); }
  .row:hover img { transform: rotate(-6deg) scale(1.05); }
  h3 {
    grid-column: 3 / 8; font-family: var(--display); font-weight: 400;
    font-size: var(--s-lead); line-height: 1.04; letter-spacing: -0.015em; text-wrap: balance;
  }
  .row p { grid-column: 9 / 13; max-width: 40ch; }
  .figures { margin-top: var(--section); background: var(--ink); color: #fff; padding-block: clamp(80px, 9vw, 144px); }
  dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); }
  dl div { display: grid; align-content: start; gap: 14px; }
  dt { font-family: var(--display); font-size: var(--s-display); line-height: 0.9; letter-spacing: -0.03em; color: var(--mint); white-space: nowrap; }
  dd { max-width: 22ch; }

  @media (max-width: 860px) {
    .row { grid-template-columns: 88px 1fr; row-gap: 16px; align-items: start; }
    .row img { grid-column: 1; grid-row: 1 / span 2; width: 88px; }
    h3 { grid-column: 2; }
    .row p { grid-column: 2; }
    dl { grid-template-columns: 1fr 1fr; row-gap: 56px; }
    dt { font-size: var(--s-head); }
  }
</style>
