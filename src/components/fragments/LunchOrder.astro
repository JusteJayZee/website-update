---
// Ordero Business: an employee's lunch for today, picked as a design-system radio card.
import type { T } from '../../i18n/content';
interface Props { t: T; phone?: boolean }
const { t, phone = false } = Astro.props;
const ui = t.ui;
const b = ui.biz;
---
<div class:list={['lo ds-screen', phone && 'lo-phone']} data-ui>
  <div class="ds-top">
    <span class="ds-child"><span class="ds-avatar" aria-hidden="true">R</span><span><b>Rūta</b><small>{b.employee}</small></span></span>
    <span class="ds-date">{ui.today} · {ui.dates[1]}</span>
  </div>
  <p class="lo-title">{b.todayLunch}</p>
  <div class="lo-options">
    {b.options.map((o, i) => (
      <div class:list={['ds-card lo-opt', i === 0 && 'on']}>
        <p class="lo-opt-head"><span class="lo-radio" aria-hidden="true"></span><b>{o[0]}</b><span class="ds-price">{o[1]}</span></p>
        <p class="lo-opt-body"><img src={`/images/ds/${i === 0 ? 'taco' : 'sandwich'}.svg`} alt="" width="26" height="26" />{o[2]}</p>
      </div>
    ))}
  </div>
  <p class="ds-callout">{b.pickup}</p>
  <div class="ds-cart"><div><b>{b.options[0][1]}</b><small>0 € {t.lang === 'lt' ? 'pristatymas' : t.lang === 'pl' ? 'dostawa' : 'delivery'}</small></div><span class="ds-btn">{b.orderPay}</span></div>
</div>

<style>
  .lo { width: 100%; max-width: 460px; padding: 18px; border-radius: 28px; box-shadow: none; }
  .lo-title { font-weight: 800; font-size: 18px; margin: 4px 2px 10px; }
  .lo-options { display: grid; gap: 8px; margin-bottom: 10px; }
  .lo-opt { overflow: hidden; }
  .lo-opt.on { border-color: var(--ds-mint); }
  .lo-opt-head { display: grid; grid-template-columns: 20px 1fr auto; gap: 10px; align-items: center; padding: 12px 14px; }
  .lo-opt.on .lo-opt-head { background: var(--ds-mint-subtle); }
  .lo-radio { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #c8c8cf; }
  .lo-opt.on .lo-radio { border: 5px solid var(--ds-mint); }
  .lo-opt-body { display: flex; align-items: center; gap: 10px; padding: 10px 14px 12px; font-size: 13.5px; color: var(--ds-text-2); }
  .lo .ds-cart { margin-top: 0; }
  .lo-phone { width: 340px; border-radius: 44px; padding: 26px 14px 18px; outline: 8px solid #18181b; }
</style>
