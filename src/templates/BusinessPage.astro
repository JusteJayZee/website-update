---
import Base from '../layouts/Base.astro';
import HeroV2 from '../components/HeroV2.astro';
import Partners from '../components/Partners.astro';
import Steps from '../components/Steps.astro';
import Why from '../components/Why.astro';
import Cta from '../components/Cta.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { t as tr, links, businessPartners, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const t = tr(Astro.props.lang);
const b = t.business;
---
<Base lang={t.lang} title={b.title} description={b.hero.lead} page="business">
  <HeroV2 t={t} page="business" h1={b.hero.h1} lead={b.hero.lead} cta={{ label: b.hero.cta, href: links.businessLogin }} />
  <main id="main">
    <Partners label={b.partners} partners={businessPartners} />
    <Steps id="steps" h2={b.steps.h2} lead={b.steps.lead} items={b.steps.items} ills={['download', 'select', 'pickup']} label={t.ui.stepsLabel} field="yellow" />
    <Why h2={b.why.h2} items={b.why.items} ills={['hours', 'seconds', 'delivery']} stats={b.stats} />
    <Cta t={t} mode="business" h2={b.cta.h2} lines={b.cta.lines} field="yellow" />
    <Contact t={t} field="mint" />
  </main>
  <Footer t={t} page="business" />
</Base>
